# ---------------------------------------------------------------------------
# ai-workflow-builder · web — build-time environment
#
# Copy to .env (or set in CI). Only variables prefixed VITE_ reach the client
# bundle; everything else stays server-side (see vite.config.js).
# ---------------------------------------------------------------------------

# Base URL the SPA calls for API requests. Baked into the bundle at BUILD time
# by client.js: `import.meta.env.VITE_API_URL || '/api'`.
#
#   - Unset (default): relative "/api" — in local dev the Vite dev server
#     proxies it to the backend (no CORS); on Cloudflare Pages this only
#     works if the API is served from the same origin (not our setup).
#   - Local dev against a directly-reachable API (bypassing the proxy):
#     VITE_API_URL=http://localhost:4000/api
#   - Production (CI sets this in .github/workflows/ci-cd.yml):
#     VITE_API_URL=https://api.workflow-builders.com/api
# VITE_API_URL=

# Where the Vite dev server forwards /api requests (dev only, server-side).
# Independent of VITE_API_URL so a production API URL can never hijack the
# local proxy.
# API_TARGET=http://localhost:4000

# Clerk authentication (Increment 2).
#
#   - Set: the app runs full Clerk integration — session JWTs, organization
#     switching, and real OAuth (GitHub/Google) sign-in. Obtain from the
#     Clerk dashboard (Frontend API key / Publishable key).
#   - Unset: the app renders the dev shell — simulated OAuth buttons, org
#     switcher, and an RBAC role switch — so local development and previews
#     work without Clerk credentials. Production must set this.
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
