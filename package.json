{
  "name": "ai-workflow-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a one-line prompt into a validated agent workflow — grill-me spec refinement, React UI, Node.js + SQLite backend.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server",
    "lint": "npm run lint --workspace=server"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "vite": "^6.4.3"
  }
}
